{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/api_secret.txt)",
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(rm -r*)",
      "Bash(rm -f*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Edit(**/examples/**)",
      "Write(**/examples/**)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(Remove-Item*)",
      "Bash(del *)",
      "Bash(git clean*)",
      "Bash(git checkout --*)",
      "Edit(**/checks/fixtures/**)",
      "Write(**/checks/fixtures/**)"
    ],
    "ask": [
      "Bash(python evolver.py run*)",
      "Bash(python evolver.py schedule*)",
      "Bash(python evolver.py install-hook*)",
      "Bash(python quickstart.py*)",
      "Bash(python scheduled_run.py install*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/py_compile_check.py\""
          }
        ]
      }
    ]
  }
}
